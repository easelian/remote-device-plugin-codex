{
  "name": "remote-device-plugin-codex-tooling",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/clean_tooling.mjs && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test .build/tooling/tests/*.test.js && python3 -m unittest discover -s tests -p '*_test.py'",
    "submission": "node .build/tooling/scripts/prepare_submission.js",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "style:check": "biome check .",
    "package": "npm run build && npm run submission",
    "dev:prepare": "npm run build && node .build/tooling/scripts/prepare_development.js",
    "dev:install": "npm run dev:prepare && codex plugin marketplace add ./.build/development && codex plugin add remote-device-hub@rdh-development --json",
    "dev:check": "python3 scripts/check_codex_plugin.py --source .build/development/plugins/remote-device-hub",
    "dev:verify": "python3 scripts/check_codex_plugin.py --installed",
    "dev:status": "codex plugin list --marketplace rdh-development --json",
    "package:draft": "npm run build && npm run submission -- --allow-incomplete"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "EaseLian",
    "email": "easeliannet@gmail.com",
    "url": "https://easelian.com/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/easelian/remote-device-plugin-codex.git"
  },
  "homepage": "https://easelian.com/"
}
